[Unit]
Description=IEC 104 Shield gateway
Documentation=file:/usr/share/doc/iec104-shield/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iec104-shield
Group=iec104-shield
ExecStart=/usr/local/bin/iec104-shield gateway --config /etc/iec104-shield/gateway.yaml
Restart=on-failure
RestartSec=2s

# Binding port 2404 needs CAP_NET_BIND_SERVICE; no other capability is needed.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Filesystem and kernel hardening. The audit directory is the only writable
# path the process needs.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/iec104-shield
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
